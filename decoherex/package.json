{
    "name": "quantum-flow-dash-root",
    "version": "1.0.0",
    "description": "Root orchestrator for QuantumFlowDash",
    "scripts": {
        "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
        "start:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 0.0.0.0 --port 5001",
        "start:frontend": "cd frontend/decoherex_analytics && npm start",
        "install:frontend": "cd frontend/decoherex_analytics && npm install"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}